/* Kaibo dock stylesheet. @name@ placeholders are filled from tokens.json for the
   active theme (dark or light) by src/ui/theme.cpp. Mirror of the design system's
   components/bundle.css — change both together. Colours, spacings and radii must
   come from tokens.json; tools/check-theme.py enforces that in CI. */

#KaiboDock, #KaiboDock #KbScroll, #KaiboDock #KbContent {
	background: @canvas@;
	color: @ink@;
}
#KaiboDock QScrollArea { border: none; background: transparent; }
#KaiboDock QScrollBar:vertical { background: transparent; width: @space-2@; margin: 2px; }
#KaiboDock QScrollBar::handle:vertical { background: @line@; border-radius: @radius-sm@; min-height: @space-6@; }
#KaiboDock QScrollBar::handle:vertical:hover { background: @line-strong@; }
#KaiboDock QScrollBar::add-line, #KaiboDock QScrollBar::sub-line,
#KaiboDock QScrollBar::add-page, #KaiboDock QScrollBar::sub-page { height: 0; background: none; }

/* Text roles */
#KaiboDock QLabel { color: @ink@; background: transparent; font-size: 13px; }
#KaiboDock QLabel[kbText="brand"] { font-size: 13px; font-weight: 600; }
#KaiboDock QLabel[kbText="title"] { font-size: 15px; font-weight: 600; }
#KaiboDock QLabel[kbText="strong"] { font-weight: 600; }
#KaiboDock QLabel[kbText="caption"] { font-size: 11px; color: @ink-muted@; }
#KaiboDock QLabel[kbText="faint"] { font-size: 11px; color: @ink-faint@; }
#KaiboDock QLabel[kbText="label"] { font-size: 11px; font-weight: 600; color: @ink-muted@; }
#KaiboDock QLabel[kbText="danger"] { font-size: 11px; color: @danger@; }
#KaiboDock QLabel[kbText="timer"] { font-size: 22px; font-weight: 600; }
#KaiboDock QLabel[kbText="mono"] { font-size: 12px; }

/* Cards */
#KaiboDock QFrame[kbCard="true"] {
	background: @surface@;
	border: 1px solid @line@;
	border-radius: @radius-md@;
}
#KaiboDock QFrame[kbCard="true"] QLabel { background: transparent; }
#KaiboDock QFrame[kbDivider="true"] { background: @line@; border: none; max-height: 1px; min-height: 1px; }

/* Buttons */
#KaiboDock QPushButton, #KaiboDock QToolButton {
	min-height: @control-md@;
	padding: 0 @space-3@;
	border-radius: @radius-md@;
	border: 1px solid @line-strong@;
	background: @surface-raised@;
	color: @ink@;
	font-size: 13px;
	font-weight: 600;
}
#KaiboDock QPushButton:hover, #KaiboDock QToolButton:hover { background: @surface@; border-color: @ink-muted@; }
#KaiboDock QPushButton:focus, #KaiboDock QToolButton:focus { border: 2px solid @focus@; }
#KaiboDock QPushButton:disabled { color: @ink-faint@; border-color: @line@; background: @surface-raised@; }
#KaiboDock QPushButton[kbVariant="primary"] { background: @brand@; border-color: @brand@; color: @on-brand@; }
#KaiboDock QPushButton[kbVariant="primary"]:hover { background: @brand-hover@; border-color: @brand-hover@; }
#KaiboDock QPushButton[kbVariant="primary"]:pressed { background: @brand-pressed@; }
#KaiboDock QPushButton[kbVariant="primary"]:focus { border: 2px solid @focus@; }
#KaiboDock QPushButton[kbVariant="primary"]:disabled { background: @surface-raised@; border-color: @line@; color: @ink-faint@; }
#KaiboDock QPushButton[kbVariant="ghost"] { background: transparent; border-color: transparent; color: @ink-muted@; }
#KaiboDock QPushButton[kbVariant="ghost"]:hover { background: @surface-raised@; color: @ink@; }
#KaiboDock QPushButton[kbVariant="danger"] { background: transparent; border-color: @danger@; color: @danger@; }
#KaiboDock QPushButton[kbVariant="danger"]:hover { background: @danger-soft@; }
#KaiboDock QPushButton[kbSize="sm"] {
	min-height: @control-sm@; padding: 0 @space-2@; font-size: 12px; border-radius: @radius-sm@;
}
#KaiboDock QPushButton[kbVariant="icon"], #KaiboDock QToolButton[kbVariant="icon"] {
	min-height: @control-sm@; min-width: @control-sm@; max-height: @control-sm@; max-width: @control-sm@;
	padding: 0; border: none; border-radius: @radius-sm@; background: transparent;
}
#KaiboDock QPushButton[kbVariant="icon"]:hover, #KaiboDock QToolButton[kbVariant="icon"]:hover { background: @surface-raised@; }
#KaiboDock QPushButton[kbVariant="icon"]:focus, #KaiboDock QToolButton[kbVariant="icon"]:focus { border: 2px solid @focus@; }
#KaiboDock QToolButton[kbVariant="icon"]::menu-indicator { image: none; width: 0; }
#KaiboDock QPushButton[kbVariant="select"] {
	text-align: left; padding: 0 @space-2@; font-weight: 400; border-radius: @radius-sm@;
	background: @surface-raised@; border: 1px solid @line-strong@;
}
#KaiboDock QPushButton[kbVariant="chip"] {
	min-height: @control-sm@; padding: 0 @space-2@; font-size: 12px; font-weight: 400;
	border-radius: @radius-sm@; border: 1px solid @line@; background: @surface-raised@;
}
#KaiboDock QPushButton[kbVariant="chip"][kbOn="true"] { background: @brand-soft@; color: @brand-ink@; border-color: @brand-soft@; font-weight: 600; }
/* ToggleSwitch paints itself (track, knob, focus ring); keep the generic button
   chrome from drawing behind it. */
#KaiboDock QPushButton[kbSwitch="true"] {
	min-height: 0px; min-width: 0px; padding: 0; border: none;
	background: transparent; border-radius: @radius-pill@;
}
#KaiboDock QPushButton[kbSwitch="true"]:hover { background: transparent; border: none; }
#KaiboDock QPushButton[kbSwitch="true"]:focus { border: none; }
#KaiboDock QPushButton[kbSwitch="true"]:disabled { background: transparent; border: none; }

/* The Go Live button */
#KaiboDock QPushButton#KbGoLive {
	min-height: @control-lg@; border-radius: @radius-lg@; border: none;
	background: @brand@; color: @on-brand@; font-size: 15px; font-weight: 600;
}
#KaiboDock QPushButton#KbGoLive:hover { background: @brand-hover@; }
#KaiboDock QPushButton#KbGoLive:pressed { background: @brand-pressed@; }
#KaiboDock QPushButton#KbGoLive:focus { border: 2px solid @focus@; }
#KaiboDock QPushButton#KbGoLive[kbState="busy"] { background: @brand-pressed@; }
#KaiboDock QPushButton#KbGoLive[kbState="end"] { background: @surface-raised@; color: @danger@; border: 1px solid @danger@; }
#KaiboDock QPushButton#KbGoLive[kbState="end"]:hover { background: @danger-soft@; }
#KaiboDock QPushButton#KbGoLive:disabled { background: @surface-raised@; color: @ink-faint@; border: 1px solid @line@; }

/* Fields */
#KaiboDock QLineEdit, #KaiboDock QPlainTextEdit {
	min-height: @control-md@; padding: 0 @space-2@;
	border-radius: @radius-sm@; border: 1px solid @line-strong@;
	background: @surface-raised@; color: @ink@; font-size: 13px;
	selection-background-color: @brand-soft@; selection-color: @ink@;
}
#KaiboDock QPlainTextEdit { padding: @space-1@; }
#KaiboDock QLineEdit:focus, #KaiboDock QPlainTextEdit:focus { border: 2px solid @focus@; }
#KaiboDock QLineEdit[kbError="true"], #KaiboDock QPlainTextEdit[kbError="true"] { border: 1px solid @danger@; }
#KaiboDock QLineEdit[readOnly="true"] { background: @surface-sunken@; border: 1px solid @line@; font-size: 12px; }

/* Banners */
#KaiboDock QFrame[kbBanner="warn"] { background: @warning-soft@; border-radius: @radius-md@; }
#KaiboDock QFrame[kbBanner="error"] { background: @danger-soft@; border-radius: @radius-md@; }
#KaiboDock QFrame[kbBanner="info"] { background: @surface-raised@; border-radius: @radius-md@; }

/* Toast (a normal row under the scrolling content, so it never covers a control) */
#KaiboDock QFrame#KbToast { background: @surface@; border: 1px solid @line-strong@; border-radius: @radius-md@; }

/* Popups and menus (children of the dock inherit this sheet) */
QFrame#KbPopup { background: @surface@; border: 1px solid @line-strong@; border-radius: @radius-md@; }
QFrame#KbPopup QLabel { color: @ink-muted@; font-size: 11px; font-weight: 600; background: transparent; }
QFrame#KbPopup QLineEdit {
	min-height: @control-md@; padding: 0 @space-2@; border-radius: @radius-sm@; border: 2px solid @focus@;
	background: @surface-raised@; color: @ink@; font-size: 13px;
}
QFrame#KbPopup QPushButton {
	min-height: @control-sm@; padding: 0 @space-2@; font-size: 12px; border-radius: @radius-sm@;
	border: 1px solid @line@; background: @surface-raised@; color: @ink@;
}
QFrame#KbPopup QPushButton[kbOn="true"] { background: @brand-soft@; color: @brand-ink@; border-color: @brand-soft@; font-weight: 600; }
QFrame#KbPopup QListWidget { background: transparent; border: none; color: @ink@; font-size: 13px; outline: none; }
QFrame#KbPopup QListWidget::item { min-height: @control-sm@; padding: 0 @space-2@; border-radius: @radius-sm@; }
QFrame#KbPopup QListWidget::item:hover { background: @surface-raised@; }
QFrame#KbPopup QListWidget::item:selected { background: @brand-soft@; color: @brand-ink@; }
QFrame#KbPopup QScrollBar:vertical { background: transparent; width: @space-2@; margin: 2px; }
QFrame#KbPopup QScrollBar::handle:vertical { background: @line-strong@; border-radius: @radius-sm@; min-height: @space-6@; }
QFrame#KbPopup QScrollBar::add-line, QFrame#KbPopup QScrollBar::sub-line { height: 0; }

#KaiboDock QMenu {
	background: @surface@; border: 1px solid @line-strong@; border-radius: @radius-sm@; padding: @space-1@; color: @ink@;
}
#KaiboDock QMenu::item { padding: @space-1@ @space-3@; border-radius: @radius-sm@; }
#KaiboDock QMenu::item:selected { background: @surface-raised@; }
#KaiboDock QMenu::separator { height: 1px; background: @line@; margin: @space-1@ 0; }

#KaiboDock QToolTip { background: @surface@; color: @ink@; border: 1px solid @line-strong@; padding: @space-1@ @space-2@; }
